# ==========================================================
# Competitor Monitor - environment template
# Copy to .env and fill real values
# ==========================================================

# ------------------------
# Shared backend (required)
# Used by: monitor.py, news_monitor.py, mentions_monitor.py, bot.py
# ------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
TELEGRAM_BOT_TOKEN=1234567890:your_bot_token
TELEGRAM_CHAT_ID=123456789
GROQ_API_KEY=your_groq_api_key

# Comma-separated Telegram group chat IDs for digest/report delivery.
# This is the key currently used by code and GitHub Actions.
TELEGRAM_GROUP_CHAT_ID=-1001111111111,-1002222222222

# Optional bot deep link shown in generated messages.
# Default in code: https://t.me/skai_compit_bot
BOT_URL=https://t.me/your_bot_username

# ------------------------
# News monitor (optional)
# ------------------------
# Number of days included in news digest period.
# Default in code: 7
NEWS_PERIOD_DAYS=7

# ------------------------
# Mentions monitor
# ------------------------
# Required for Yandex source
YANDEX_SEARCH_API_KEY=your_yandex_search_api_key
YANDEX_SEARCH_FOLDER_ID=your_yandex_folder_id

# ------------------------
# Telegram bot webhook server
# Used by: bot.py
# ------------------------
# Public HTTPS URL of deployed bot backend (for Telegram webhook).
WEBHOOK_URL=https://your-app.onrender.com

# Public URL of Telegram Mini App (button in bot messages).
WEBAPP_URL=https://your-webapp-url.example.com

# Web server port for bot.py (Render/Heroku usually injects PORT).
# Default in code: 8080
PORT=8080

# ------------------------
# Web app (Vite frontend)
# Used by: webapp/
# ------------------------
# These variables must be available for Vite build/dev.
# In local dev, keep them in webapp/.env (or export before build).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------
# Compatibility alias (optional)
# ------------------------
# Older docs can mention TELEGRAM_GROUP_CHAT_IDS (plural).
# Code reads TELEGRAM_GROUP_CHAT_ID (singular) right now.
# TELEGRAM_GROUP_CHAT_IDS=-1001111111111,-1002222222222
